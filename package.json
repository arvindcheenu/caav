{
  "name": "caav",
  "version": "0.1.0",
  "description": "Collaborative attention-aware visualization: attach attention to 3D objects, record it per viewer, and show it in every mode of the HeedVision design space.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvindcheenu/caav.git"
  },
  "homepage": "https://heedvision.arvindchee.nu/toolkit/",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "demo": "vite site --open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:site": "npm run build && vite build site"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.180",
    "three-mesh-bvh": ">=0.9"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "leva": "^0.10.1",
    "marked": "^18.1.3",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
